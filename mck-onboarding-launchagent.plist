<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mckinnonsc.onboarding</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Library/Application Support/McKinnon/mck-onboarding.sh</string>
	</array>

	<!-- Fires once, the next time this user logs in and launchd loads
	     their per-user agents — not a persistent/repeating job. -->
	<key>RunAtLoad</key>
	<true/>

	<!-- Only run in a real GUI (Aqua) session — never at the loginwindow
	     itself, and never in a background/headless session. -->
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>

	<key>StandardOutPath</key>
	<string>/var/log/mck-onboarding-launchagent.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/mck-onboarding-launchagent.log</string>
</dict>
</plist>
