<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mckinnonsc.onboarding</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Applications/McKinnon Onboarding.app/Contents/MacOS/McKinnonOnboarding</string>
	</array>

	<!-- Delivered via packaging/build-pkg.sh, which installs the app to
	     /Applications and this plist to /Library/LaunchAgents, with a
	     postinstall script that bootstraps it immediately. (Mosyle's
	     Background Task Management zip-upload feature was tried instead
	     — pointing this at its managed path — but hit an unexplained
	     "Unknown error" server-side, so that approach was dropped.)

	     Fires once, the next time this user logs in and launchd loads
	     their per-user agents — not a persistent/repeating job. There's
	     also now a companion LaunchDaemon
	     (mck-onboarding-launchdaemon.plist) that bridges into the console
	     user's session via launchctl asuser instead of relying on this
	     Agent's own login timing — confirmed working in testing where
	     this Agent's execution was confirmed via logs but never actually
	     showed a window. Both are shipped side by side for now, neither
	     deleted, until we're confident which one (or both) actually needs
	     to stay. -->
	<key>RunAtLoad</key>
	<true/>

	<!-- Only run in a real GUI (Aqua) session — never at the loginwindow
	     itself, and never in a background/headless session. -->
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>

	<!-- /var/log is root-only — a standard user (the normal case, since
	     LaunchAgents always run as the console user) can't create a file
	     there, and xpcproxy failing to set this up before the job even
	     starts is EXACTLY what caused the original EX_CONFIG/exit-78
	     failure. /var/tmp is world-writable (sticky bit) and persists
	     across reboots, unlike /tmp. This plist is a single static file
	     shared by whichever user logs in, so it can't reference a
	     per-user path like ~/Library/Logs — that's what the script's own
	     LOG_FILE is for; this is just a catch-all for anything before
	     the script's own logging initializes. -->
	<key>StandardOutPath</key>
	<string>/private/var/tmp/mck-onboarding-launchagent.log</string>
	<key>StandardErrorPath</key>
	<string>/private/var/tmp/mck-onboarding-launchagent.log</string>
</dict>
</plist>
